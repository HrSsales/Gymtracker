{
  "openapi": "3.0.3",
  "info": {
    "title": "GymTracker API",
    "version": "1.0.0",
    "description": "API do GymTracker: usuários, treinos, exercícios e evolução de cargas. Faça login em POST /login, copie o token e clique em **Authorize**."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "tags": [
    {
      "name": "Autenticação"
    },
    {
      "name": "Perfil"
    },
    {
      "name": "Treinos"
    },
    {
      "name": "Exercícios"
    },
    {
      "name": "Evolução"
    },
    {
      "name": "Estatísticas"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Erro": {
        "type": "object",
        "properties": {
          "erro": {
            "type": "string",
            "example": "Treino não encontrado"
          }
        }
      },
      "Mensagem": {
        "type": "object",
        "properties": {
          "mensagem": {
            "type": "string"
          }
        }
      },
      "CadastroUsuario": {
        "type": "object",
        "required": [
          "nome",
          "email",
          "senha"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "example": "Ana Souza"
          },
          "email": {
            "type": "string",
            "example": "ana@email.com"
          },
          "senha": {
            "type": "string",
            "minLength": 6,
            "example": "senha123"
          }
        }
      },
      "Login": {
        "type": "object",
        "required": [
          "email",
          "senha"
        ],
        "properties": {
          "email": {
            "type": "string",
            "example": "ana@email.com"
          },
          "senha": {
            "type": "string",
            "example": "senha123"
          }
        }
      },
      "Usuario": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RespostaLogin": {
        "type": "object",
        "properties": {
          "sucesso": {
            "type": "boolean"
          },
          "token": {
            "type": "string"
          },
          "usuario": {
            "$ref": "#/components/schemas/Usuario"
          }
        }
      },
      "EditarPerfil": {
        "type": "object",
        "required": [
          "nome",
          "email"
        ],
        "properties": {
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "senha_atual": {
            "type": "string",
            "description": "Obrigatória só para trocar a senha"
          },
          "nova_senha": {
            "type": "string",
            "minLength": 6
          }
        }
      },
      "ExcluirConta": {
        "type": "object",
        "required": [
          "senha"
        ],
        "properties": {
          "senha": {
            "type": "string"
          }
        }
      },
      "TreinoEntrada": {
        "type": "object",
        "required": [
          "nome"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "example": "Treino A - Peito e Tríceps"
          },
          "descricao": {
            "type": "string",
            "example": "Segunda e quinta"
          }
        }
      },
      "Treino": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "nome": {
            "type": "string"
          },
          "descricao": {
            "type": "string",
            "nullable": true
          },
          "usuario_id": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "total_exercicios": {
            "type": "integer"
          }
        }
      },
      "ExercicioEntrada": {
        "type": "object",
        "required": [
          "nome",
          "grupo_muscular",
          "series",
          "repeticoes",
          "treino_id"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "example": "Supino reto"
          },
          "grupo_muscular": {
            "type": "string",
            "example": "Peito",
            "enum": [
              "Peito",
              "Costas",
              "Ombros",
              "Bíceps",
              "Tríceps",
              "Pernas",
              "Glúteos",
              "Abdômen",
              "Panturrilha",
              "Antebraço",
              "Corpo inteiro"
            ]
          },
          "series": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "example": 4
          },
          "repeticoes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "example": 10
          },
          "treino_id": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "Exercicio": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "nome": {
            "type": "string"
          },
          "grupo_muscular": {
            "type": "string"
          },
          "series": {
            "type": "integer"
          },
          "repeticoes": {
            "type": "integer"
          },
          "treino_id": {
            "type": "integer"
          },
          "treino_nome": {
            "type": "string"
          }
        }
      },
      "EvolucaoEntrada": {
        "type": "object",
        "required": [
          "peso",
          "data_registro",
          "exercicio_id"
        ],
        "properties": {
          "peso": {
            "type": "number",
            "example": 42.5
          },
          "data_registro": {
            "type": "string",
            "format": "date",
            "example": "2026-10-29"
          },
          "observacao": {
            "type": "string",
            "example": "Última série até a falha"
          },
          "exercicio_id": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "Evolucao": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "peso": {
            "type": "string",
            "example": "42.50"
          },
          "data_registro": {
            "type": "string",
            "format": "date"
          },
          "observacao": {
            "type": "string",
            "nullable": true
          },
          "exercicio_id": {
            "type": "integer"
          },
          "exercicio_nome": {
            "type": "string"
          },
          "treino_nome": {
            "type": "string"
          },
          "diferenca": {
            "type": "string",
            "nullable": true,
            "description": "Variação de carga em relação ao registro anterior do mesmo exercício"
          }
        }
      },
      "Stats": {
        "type": "object",
        "properties": {
          "treinos": {
            "type": "integer"
          },
          "exercicios": {
            "type": "integer"
          },
          "evolucoes": {
            "type": "integer"
          }
        }
      }
    }
  },
  "paths": {
    "/usuarios": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Cadastrar usuário",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CadastroUsuario"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuário criado"
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "409": {
            "description": "Email já cadastrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Login (devolve o token JWT)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login feito",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaLogin"
                }
              }
            }
          },
          "400": {
            "description": "Campos faltando",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "401": {
            "description": "Email ou senha inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/perfil": {
      "get": {
        "tags": [
          "Perfil"
        ],
        "summary": "Dados do usuário logado",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usuario"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "Usuário não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Perfil"
        ],
        "summary": "Editar perfil (e trocar senha, opcional)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EditarPerfil"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Atualizado (devolve token novo)"
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "409": {
            "description": "Email já cadastrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Perfil"
        ],
        "summary": "Excluir a própria conta",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExcluirConta"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "400": {
            "description": "Senha não informada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/stats": {
      "get": {
        "tags": [
          "Estatísticas"
        ],
        "summary": "Contagem de treinos, exercícios e evoluções",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stats"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/treinos": {
      "get": {
        "tags": [
          "Treinos"
        ],
        "summary": "Listar meus treinos",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Treino"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Treinos"
        ],
        "summary": "Criar treino",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TreinoEntrada"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Criado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Treino"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/treinos/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "get": {
        "tags": [
          "Treinos"
        ],
        "summary": "Buscar um treino",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Treino"
                }
              }
            }
          },
          "400": {
            "description": "ID inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "Não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Treinos"
        ],
        "summary": "Editar treino",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TreinoEntrada"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Treino"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "Não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Treinos"
        ],
        "summary": "Excluir treino (apaga exercícios e evoluções dele)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "400": {
            "description": "ID inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "Não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/exercicios/grupos": {
      "get": {
        "tags": [
          "Exercícios"
        ],
        "summary": "Grupos musculares aceitos",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de nomes"
          },
          "401": {
            "description": "Token ausente, inválido ou expirado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/exercicios": {
      "get": {
        "tags": [
          "Exercícios"
        ],
        "summary": "Listar meus exercícios",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "treino_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Exercicio"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Filtro inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
